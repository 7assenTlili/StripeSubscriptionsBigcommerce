# BigCommerce API Credentials
# Find these at: BigCommerce Admin > Advanced Settings > API Accounts
STORE_HASH=your_store_hash
BC_CLIENT=your_bigcommerce_client_id
BC_TOKEN=your_bigcommerce_access_token

# Stripe API Credentials
# Find these at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET=sk_test_your_stripe_secret_key

# Stripe Price ID for the subscription plan
# Find this at: https://dashboard.stripe.com/products (click on product > pricing)
STRIPE_PRICE_ID=price_XXXXXXXXXXXXXXXX

# Comma-separated list of BigCommerce product SKUs that should trigger a Stripe subscription
# These SKUs must match the SKUs configured in your BigCommerce product catalog
SUBSCRIPTION_SKUS=prod_example1,prod_example2
